#NOP --------------------------------------------------------------------------;
#NOP Sample game class file;
#NOP --------------------------------------------------------------------------;
#CLASS {mm} {OPEN};

#NOP Version for game.mm.;
#VARIABLE {VERSIONS[game.mm]} {v1.0.0};

_pluginCreate {mm} {Materia Magica base plugin};

#NOP Variable to track keypad movement and make sure we're not sending move;
#NOP commands faster than the game processes them when we're in manual mapping;
#NOP mode. If we don't throttle this, the manual map can get corrupted.;
#VARIABLE {MM_MOVE_AWAITING_PROMPT} {0};

#NOP --------------------------------------------------------------------------;
#NOP Functions and Aliases the base class will call while trying to connect.;
#NOP --------------------------------------------------------------------------;

#NOP Put your game's hostname in here.;
#FUNCTION {__gameHostname} {
    #RETURN {materiamagica.com};
};

#NOP Put your game's port in here.;
#FUNCTION {__gamePort} {
    #RETURN {4000};
};

#NOP Any actions that need to be done before starting the session.;
#NOP E.G. Load any other classes your game requires to be in place before;
#NOP logging in.;
#ALIAS {__gameBeforeLogin} {
    #NOP %0;
    _classLoad {mmevents} {game.mm/plugins};
    _classLoad {eventTriggers} {game.mm/plugins};
    _classLoad {captures} {game.mm/plugins};
    _classLoad {gmcp} {game.mm/plugins};
    _classLoad {magicmap} {game.mm/plugins};

    _classLoad {maputils} {game.mm/plugins};
    _classLoad {mapper} {game.mm/plugins};
    _classLoad {vtmapper} {game.mm/plugins};
    _classLoad {wildernessmapper} {game.mm/plugins};

    _classLoad {autosac} {game.mm/plugins};
    _classLoad {roomInfoWidget} {game.mm/plugins};
    _classLoad {charStatsWidget} {game.mm/plugins};
    _classLoad {vitalsWidget} {game.mm/plugins};
    _classLoad {roomDetailWidget} {game.mm/plugins};
    _classLoad {combat} {game.mm/plugins};
    _classLoad {prowl} {game.mm/plugins};

    _keepalive;

    #NOP Can be overridden with a user's personal color.;
    #VARIABLE {PERSONAL_COLOR} {<fff>};

    #NOP Can be overridden with a chat signature.;
    #VARIABLE {CHAT_SIGNATURE} {};

    #NOP Can be overridden with a chat color.;
    #VARIABLE {CHAT_COLOR} {|W};

    #NOP Use mouse input.;
    #CONFIG {MOUSE} {ON};
};

#NOP Actions to perform immediately after starting the session.;
#NOP E.G. Answer post-login game prompts to fully log in.;
#ALIAS {__gameAfterLogin} {
    #NOP %0;
    #NOP Try to go into the world.;
    1;
    #NOP Failing that, try to go into chat.;
    2;

    #NOP Trigger these values to be sent to prime plugins and such.;
    protocols gmcp sendchar;
    protocols gmcp sendroom;
};

#NOP --------------------------------------------------------------------------;
#NOP Global highlights.;
#NOP --------------------------------------------------------------------------;

#HIGHLIGHT {^%1 is right here to the %2.} {BOLD};
#GAG {%!{^You don't see anything (?:to the .*|(?:up|down)wards)\.$}};

#NOP --------------------------------------------------------------------------;
#NOP Shared functions and aliases.;
#NOP --------------------------------------------------------------------------;

#ALIAS {ls} {l};

#NOP Clan talk color.;
#ALIAS {~^ct %1$} {
    #SEND {ct ${CHAT_SIGNATURE}${CHAT_COLOR}%1|X};
};

#NOP Alliance talk color.;
#ALIAS {~^at %1$} {
    #SEND {alliance talk ${CHAT_SIGNATURE}${CHAT_COLOR}%1|X};
};

#NOP Standard desktop layout.;
_pluginCreateCommand
    {mm}
    {desktop}
    {_desktopLayout}
    {Apply standard desktop layout};
#ALIAS {_desktopLayout} {
    #NOP %0;
    _splitSize {TOP} {16};
    _splitSize {BOTTOM} {5};
    _splitSize {RIGHT} {-100};

    _panelDock {logs} {TOP} {4} {4} {6} {6};
    _panelDock {allClan} {TOP} {1} {1} {6} {3};
    _panelDock {allTalk} {TOP} {1} {4} {3} {6};

    _panelDock {roomInfo} {BOTTOM} {1} {5} {6} {6};
    _panelDock {charStats} {BOTTOM} {1} {3} {6} {4};
    _panelDock {vitals} {BOTTOM} {1} {1} {6} {2};

    _panelDock {map} {RIGHT} {1} {1} {5} {6};
    _panelDock {affects} {RIGHT} {6} {1} {6} {3};
    _panelDock {events} {RIGHT} {6} {4} {6} {6};
    #NOP _panelDock {roomDetail} {RIGHT} {6} {1} {6} {6};
};

#NOP Standard mobile layout.;
_pluginCreateCommand
    {mm}
    {mobile}
    {_mobileLayout}
    {Apply standard mobile layout};
#ALIAS {_mobileLayout} {
    #NOP %0;
    _splitSize {TOP} {16};
    _splitSize {BOTTOM} {5};
    _splitSize {RIGHT} {-72};

    _panelHide {logs};
    _panelHide {charStats};
    _panelDock {allClan} {TOP} {1} {1} {4} {6};
    _panelDock {allTalk} {TOP} {5} {1} {6} {6};

    _panelDock {roomInfo} {BOTTOM} {1} {4} {6} {6};
    _panelDock {vitals} {BOTTOM} {1} {1} {6} {3};

    _panelDock {map} {RIGHT} {1} {1} {5} {6};
    _panelDock {affects} {RIGHT} {6} {1} {6} {6};
    _panelHide {events};
    #NOP _panelHide {roomDetail} {RIGHT} {6} {1} {6} {6};
};

#NOP --------------------------------------------------------------------------;
#NOP Register and unregister events.;
#NOP --------------------------------------------------------------------------;

#NOP Handle session activation.;
_eventHandlerRegister {SESSION ACTIVATED} {_mmSessionActivatedHandler};
#ALIAS {_mmSessionActivatedHandler} {
    #NOP %0;
    #LOCAL {sessionPrefix} {};
    #FORMAT {sessionPrefix} {%.3s} {%1};
    #IF {"$sessionPrefix" == "mm."} {
        #%1 {_eventFire {SPLIT REFRESH}};
    };
};

#NOP Movement wrapper.;
#NOP %1 - command/direction.;
#ALIAS {_mmMove} {
    #NOP %0;
    #NOP %1 is either a direction, "look" or "flee <direction>".;
    #LOCAL {command} {%1};
    #LIST {command} {EXPLODE} { };
    #IF {&command[] == 1} {
        #NOP No spaces in string, not fleeing.;
        #LOCAL {direction} {$command[1]};
    }; #ELSE {
        #NOP Fleeing.;
        #LOCAL {direction} {$command[2]};
    };

    #IF {@_flagsGetFlag{{VT_MAPPER}; {MANUAL}}} {
        #IF {@_flagsGetFlag{{VT_MAPPER}; {MOVE_RELATED_COMMAND_ISSUED}}} {
            _warn {SLOWWWWW DOWWWNNNNNNN};
            _bell ring;
            #LIST {VT_MAPPER_MOVEMENT_QUEUE} {INSERT} {-1} {%1};
            #RETURN;
        };

        #LINE {IGNORE} {%1};

        #IF {"$direction" != "l" && "$direction" != "look"} {
            #MAP {MOVE} {$direction};
        };
        _eventFire {MOVE COMMAND} {$direction};
    }; #ELSE {
        _eventFire {MOVE COMMAND} {$direction};
        #LINE {IGNORE} {%1};
    };
};

#ALIAS {^n$} {_mmMove {n};};
#ALIAS {^ne$} {_mmMove {ne};};
#ALIAS {^e$} {_mmMove {e};};
#ALIAS {^se$} {_mmMove {se};};
#ALIAS {^s$} {_mmMove {s};};
#ALIAS {^sw$} {_mmMove {sw};};
#ALIAS {^w$} {_mmMove {w};};
#ALIAS {^nw$} {_mmMove {nw};};
#ALIAS {^u$} {_mmMove {u};};
#ALIAS {^d$} {_mmMove {d};};
#ALIAS {^l$} {_mmMove {look};};
#ALIAS {^look$} {_mmMove {look};};
#ALIAS {^fl %1} {_mmMove {flee %1}};
#ALIAS {^fle %1} {_mmMove {flee %1}};
#ALIAS {^flee %1} {_mmMove {flee %1}};

#NOP Numpad movement.;
_eventHandlerRegister {NUMPAD 8} {_mmNumpad8Handler};
#ALIAS {_mmNumpad8Handler} {
    #NOP %0;
    n;
};
_eventHandlerRegister {NUMPAD 9} {_mmNumpad9Handler};
#ALIAS {_mmNumpad9Handler} {
    #NOP %0;
    ne;
};
_eventHandlerRegister {NUMPAD 6} {_mmNumpad6Handler};
#ALIAS {_mmNumpad6Handler} {
    #NOP %0;
    e;
};
_eventHandlerRegister {NUMPAD 3} {_mmNumpad3Handler};
#ALIAS {_mmNumpad3Handler} {
    #NOP %0;
    se;
};
_eventHandlerRegister {NUMPAD 2} {_mmNumpad2Handler};
#ALIAS {_mmNumpad2Handler} {
    #NOP %0;
    s;
};
_eventHandlerRegister {NUMPAD 1} {_mmNumpad1Handler};
#ALIAS {_mmNumpad1Handler} {
    #NOP %0;
    sw;
};
_eventHandlerRegister {NUMPAD 4} {_mmNumpad4Handler};
#ALIAS {_mmNumpad4Handler} {
    #NOP %0;
    w;
};
_eventHandlerRegister {NUMPAD 7} {_mmNumpad7Handler};
#ALIAS {_mmNumpad7Handler} {
    #NOP %0;
    nw;
};
_eventHandlerRegister {NUMPAD 5} {_mmNumpad5Handler};
#ALIAS {_mmNumpad5Handler} {
    #NOP %0;
    look;
};
_eventHandlerRegister {NUMPAD PLUS} {_mmNumpadPlusHandler};
#ALIAS {_mmNumpadPlusHandler} {
    #NOP %0;
    u;
};
_eventHandlerRegister {NUMPAD MINUS} {_mmNumpadMinusHandler};
#ALIAS {_mmNumpadMinusHandler} {
    #NOP %0;
    d;
};
_eventHandlerRegister {NUMPAD 0} {_mmNumpad0Handler};
#ALIAS {_mmNumpad0Handler} {
    #NOP %0;
    _prowlInvoke;
};

#NOP Numpad looking.;
_eventHandlerRegister {NUMPAD SHIFT 8} {_mmNumpadShift8Handler};
#ALIAS {_mmNumpadShift8Handler} {
    #NOP %0;
    #SEND {look north};
};
_eventHandlerRegister {NUMPAD SHIFT 9} {_mmNumpadShift9Handler};
#ALIAS {_mmNumpadShift9Handler} {
    #NOP %0;
    #SEND {look northeast};
};
_eventHandlerRegister {NUMPAD SHIFT 6} {_mmNumpadShift6Handler};
#ALIAS {_mmNumpadShift6Handler} {
    #NOP %0;
    #SEND {look east};
};
_eventHandlerRegister {NUMPAD SHIFT 3} {_mmNumpadShift3Handler};
#ALIAS {_mmNumpadShift3Handler} {
    #NOP %0;
    #SEND {look southeast};
};
_eventHandlerRegister {NUMPAD SHIFT 2} {_mmNumpadShift2Handler};
#ALIAS {_mmNumpadShift2Handler} {
    #NOP %0;
    #SEND {look south};
};
_eventHandlerRegister {NUMPAD SHIFT 1} {_mmNumpadShift1Handler};
#ALIAS {_mmNumpadShift1Handler} {
    #NOP %0;
    #SEND {look southwest};
};
_eventHandlerRegister {NUMPAD SHIFT 4} {_mmNumpadShift4Handler};
#ALIAS {_mmNumpadShift4Handler} {
    #NOP %0;
    #SEND {look west};
};
_eventHandlerRegister {NUMPAD SHIFT 7} {_mmNumpadShift7Handler};
#ALIAS {_mmNumpadShift7Handler} {
    #NOP %0;
    #SEND {look northwest};
};
_eventHandlerRegister {NUMPAD SHIFT 5} {_mmNumpadShift5Handler};
#ALIAS {_mmNumpadShift5Handler} {
    #NOP %0;
    #SEND {look};
};
_eventHandlerRegister {NUMPAD SHIFT PLUS} {_mmNumpadShiftPlusHandler};
#ALIAS {_mmNumpadShiftPlusHandler} {
    #NOP %0;
    #SEND {look up};
};
_eventHandlerRegister {NUMPAD SHIFT MINUS} {_mmNumpadShiftMinusHandler}
#ALIAS {_mmNumpadShiftMinusHandler} {
    #NOP %0;
    #SEND {look down};
};
_eventHandlerRegister {NUMPAD SHIFT 0} {_mmNumpadShift0Handler}
#ALIAS {_mmNumpadShift0Handler} {
    #NOP %0;
    #SEND {inventory};
};

#NOP Numpad movement + scan.;
_eventHandlerRegister {NUMPAD CTRL 8} {_mmNumpadCtrl8Handler};
#ALIAS {_mmNumpadCtrl8Handler} {
    #NOP %0;
    n;
    scan;
};
_eventHandlerRegister {NUMPAD CTRL 9} {_mmNumpadCtrl9Handler};
#ALIAS {_mmNumpadCtrl9Handler} {
    #NOP %0;
    ne;
    scan;
};
_eventHandlerRegister {NUMPAD CTRL 6} {_mmNumpadCtrl6Handler};
#ALIAS {_mmNumpadCtrl6Handler} {
    #NOP %0;
    e;
    scan;
};
_eventHandlerRegister {NUMPAD CTRL 3} {_mmNumpadCtrl3Handler};
#ALIAS {_mmNumpadCtrl3Handler} {
    #NOP %0;
    se;
    scan;
};
_eventHandlerRegister {NUMPAD CTRL 2} {_mmNumpadCtrl2Handler};
#ALIAS {_mmNumpadCtrl2Handler} {
    #NOP %0;
    s;
    scan;
};
_eventHandlerRegister {NUMPAD CTRL 1} {_mmNumpadCtrl1Handler};
#ALIAS {_mmNumpadCtrl1Handler} {
    #NOP %0;
    sw;
    scan;
};
_eventHandlerRegister {NUMPAD CTRL 4} {_mmNumpadCtrl4Handler};
#ALIAS {_mmNumpadCtrl4Handler} {
    #NOP %0;
    w;
    scan;
};
_eventHandlerRegister {NUMPAD CTRL 7} {_mmNumpadCtrl7Handler};
#ALIAS {_mmNumpadCtrl7Handler} {
    #NOP %0;
    nw;
    scan;
};
_eventHandlerRegister {NUMPAD CTRL 5} {_mmNumpadCtrl5Handler};
#ALIAS {_mmNumpadCtrl5Handler} {
    #NOP %0;
    look;
    scan;
};
_eventHandlerRegister {NUMPAD CTRL PLUS} {_mmNumpadCtrlPlusHandler};
#ALIAS {_mmNumpadCtrlPlusHandler} {
    #NOP %0;
    u;
    scan;
};
_eventHandlerRegister {NUMPAD CTRL MINUS} {_mmNumpadCtrlMinusHandler};
#ALIAS {_mmNumpadCtrlMinusHandler} {
    #NOP %0;
    d;
    scan;
};

#CLASS {mm} {CLOSE};
