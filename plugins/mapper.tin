#NOP --------------------------------------------------------------------------;
#NOP MM General Mapper Class.;
#NOP --------------------------------------------------------------------------;
#CLASS {mapper} {OPEN};

#NOP --------------------------------------------------------------------------;
#NOP Declare plugin and flags.;
#NOP --------------------------------------------------------------------------;

_pluginCreate {map} {Base mapping functionality};

_flagsRegisterScope {MAPPER};

#NOP Flag to track if we're in a wilderness room.;
_flagsRegisterFlag {MAPPER} {WILDERNESS} {0};

#NOP Flag to track if we're in a PK room.;
_flagsRegisterFlag {MAPPER} {PK} {0};

#NOP Flag to track if we're in a NPK room.;
_flagsRegisterFlag {MAPPER} {NPK} {0};

#NOP Flag to track if we're in a LPK room.;
_flagsRegisterFlag {MAPPER} {LPK} {0};

#NOP Flag to track if we're in a CPK room.;
_flagsRegisterFlag {MAPPER} {CPK} {0};

#NOP Flag to toggle click-to-walk.;
_flagsRegisterFlag {MAPPER} {CLICK_TO_WALK} {1};

#NOP --------------------------------------------------------------------------;
#NOP Event handlers.;
#NOP --------------------------------------------------------------------------;

_eventRegister {VT MAP LOADED};
_eventRegister {VT MAP UPDATED};
_eventRegister {WILDERNESS MAP UPDATED};

#NOP GMCP Room Data.;
_eventHandlerRegister {IAC SB GMCP room.info IAC SE} {__mapperRoomInfoHandler} {1};
#ALIAS {__mapperRoomInfoHandler} {
    #NOP %0;
    _trace {__mapperRoomInfoHandler};
    __mapperUpdateFlags;
};

#NOP Render map when VT Map has been updated.;
_eventHandlerRegister {VT MAP UPDATED} {__mapperVtMapUpdatedHandler};
#ALIAS {__mapperVtMapUpdatedHandler} {
    #NOP %0;
    _trace {__mapperVtMapUpdatedHandler};
    #IF {!@_flagsGetFlag{{MAPPER}; {WILDERNESS}}} {
        #NOP If we're in the wilderness, the wilderness map update will send;
        #NOP its own event to render the map. It has to wait for the prompt to;
        #NOP arrive, so the processing is delayed.;
        _eventFire {WIDGET UPDATED mapWidget};
    };
};

#NOP Render map when Wilderness map has been updated.;
_eventHandlerRegister {WILDERNESS MAP UPDATED} {__mapperWildernessMapUpdatedHandler};
#ALIAS {__mapperWildernessMapUpdatedHandler} {
    #NOP %0;
    _trace {__mapperWildernessMapUpdatedHandler};
    _eventFire {WIDGET UPDATED mapWidget};
};

#NOP --------------------------------------------------------------------------;
#NOP Public Aliases.;
#NOP --------------------------------------------------------------------------;

_pluginCreateCommand
    {map}
    {activate}
    {_mapperActivate}
    {Put the map in active mode}
    {
        {1} {Which map to activate (VT|WILDERNESS|ALL)}
    }
    {When in active mode, updates to the VT map will be written to disk on disconnect. If you are playing multiple characters at once, only one should be in active mode, or else the map file could become corrupted. Updates to the wilderness map are written to disk in realtime, and multiple characters using the same map will not be an issue, but there may still be times you wish to deactivate updating the wilderness map.};
#ALIAS {_mapperActivate} {
    #NOP %0;
    #LOCAL {map} {%1};
    #FORMAT {map} {%u} {$map};

    #IF {"$map" == "VT"} {
        _flagsSetFlag {VT_MAPPER} {ACTIVE} {1};
    }; #ELSEIF {"$map" == "WILDERNESS"} {
        _flagsSetFlag {WILDERNESS_MAPPER} {ACTIVE} {1};
    }; #ELSEIF {"$map" == "ALL"} {
        _flagsSetFlag {VT_MAPPER} {ACTIVE} {1};
        _flagsSetFlag {WILDERNESS_MAPPER} {ACTIVE} {1};
    }; #ELSE {
        _error {Unknown value "$map"};
    };
};

_pluginCreateCommand
    {map}
    {deactivate}
    {_mapperDeactivate}
    {Put the map in passive mode}
    {}
    {When in passive mode, the map will not be updated as you move to new rooms, and will not be written to disk on disconnect. If you are playing multiple characters at once, only one should be in active mode, or else the map file could become corrupted.};
#ALIAS {_mapperDeactivate} {
    #NOP %0;
    _flagsSetFlag {VT_MAPPER} {ACTIVE} {0};
};

#NOP Clicking on a room.;
_eventHandlerRegister {MAP ROOM SHORT-CLICKED MOUSE BUTTON ONE} {__mapperMapClickedHandler};
#ALIAS {__mapperMapClickedHandler} {
    #NOP %0;
    #IF {!@_flagsGetFlag{{MAPPER}; {WILDERNESS}} && @_flagsGetFlag{{MAPPER}; {CLICK_TO_WALK}}} {
        _vtmapperGo {%5};
    };
};

#NOP --------------------------------------------------------------------------;
#NOP Private Aliases.;
#NOP --------------------------------------------------------------------------;

#NOP Update game state flags based on the current GMCP room data.;
#ALIAS {__mapperUpdateFlags} {
    #NOP %0;
    _trace {__mapperUpdateFlags};
    #LOCAL {room} {$GMCP[room][info]};
    #LOCAL {value} {};

    #MATH {value} {&room[coord][sym] > 0};
    _flagsSetFlag {MAPPER} {WILDERNESS} {$value};

    #LOCAL {flags} {@_maputilsGetRoomFlags{}};
    #LOCAL {pk} {0};

    #MATH {value} {&flags[NPK] > 0};
    #MATH {pk} {$pk || $value};
    _flagsSetFlag {MAPPER} {NPK} {$value};

    #MATH {value} {&flags[LPK] > 0};
    #MATH {pk} {$pk || $value};
    _flagsSetFlag {MAPPER} {LPK} {$value};

    #MATH {value} {&flags[CPK] > 0};
    #MATH {pk} {$pk || $value};
    _flagsSetFlag {MAPPER} {CPK} {$value};

    _flagsSetFlag {MAPPER} {PK} {$pk};
};

#NOP --------------------------------------------------------------------------;
#NOP Widget/Panel.;
#NOP --------------------------------------------------------------------------;

_widgetCreate {mapWidget} {__mapWidgetDraw};
_pluginCreatePanel {map} {map} {The one and only multi-purpose map panel};
_panelCreate {map} {WIDGET} {mapWidget};

#NOP Draw the map widget.;
#NOP %1 - Data.;
#NOP %2 - Top coordinate.;
#NOP %3 - Left coordinate.;
#NOP %4 - Bottom coordinate.;
#NOP %5 - Right coordinate.;
#ALIAS {__mapWidgetDraw} {
    #NOP %0;
    _trace {__mapWidgetDraw};

    #LOCAL {vtMapFlag} {@_maputilsGetVTMAPFlag{}};

    #IF {@_flagsGetFlag{{MAPPER}; {WILDERNESS}}} {
        #NOP Draw wilderness map.;
        #IF {$vtMapFlag} {
            #MAP {FLAG} {VTMAP} {OFF};
        };
        #LOCAL {width} {};
        #LOCAL {height} {};
        #MATH {width} {%5 - %3 - 1};
        #MATH {height} {%4 - %2 - 1};

        #LOCAL {mapName} {${GMCP[room][info][zone]}};
        #IF {"$mapName" == "The Airship |UInconvenience|X"} {
            #LOCAL {mapName} {Alyria};
        };

        #LOCAL {result} {};
        _trace {Reading wilderness map: "$__base/game.mm/plugins/mapper/mapper_read" "$__base/game.mm/plugins/mapper/${mapName}.map" ${GMCP[room][info][coord][x]} ${GMCP[room][info][coord][y]} $width $height};
        #SCRIPT {result} {"$__base/game.mm/plugins/mapper/mapper_read" "$__base/game.mm/plugins/mapper/${mapName}.map" ${GMCP[room][info][coord][x]} ${GMCP[room][info][coord][y]} $width $height};
        #DRAW {$BOX_COLOR} {$BOX_STYLE} {TALIGN} {BOX} {%2} {%3} {%4} {%5} $result[1..$height];
    }; #ELSE {
        #NOP Draw VT map.;
        #IF {@_flagsGetFlag{{VT_MAPPER}; {LOADED}}} {
            #IF {!$vtMapFlag} {
                #DRAW {$BOX_COLOR} {$BOX_STYLE} {BOX} {%2} {%3} {%4} {%5};
                #MAP {OFFSET} {%2 + 1 + $MAP_TWEAK[TOP]} {%3 + 1 + $MAP_TWEAK[LEFT]} {%4 - 1 + $MAP_TWEAK[BOTTOM]} {%5 - 1 + $MAP_TWEAK[RIGHT]};
                #MAP {FLAG} {VTMAP} {ON};
            };
        }; #ELSE {
            #SCREEN {CLEAR} {SQUARE} {%2} {%3} {%4} {%5};
            #DRAW {$BOX_COLOR} {$BOX_STYLE} {BOX} {%2} {%3} {%4} {%5};
        };
    };
};

#CLASS {mapper} {CLOSE};